# Port number for the Express server to run on
PORT=5000

# MongoDB Connection URI
# Local MongoDB connection:
# MONGODB_URI=mongodb://127.0.0.1:27017/laundry_db
#
# MongoDB Atlas cloud connection:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/<db-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/laundry_db
